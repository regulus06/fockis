# Mailchimp Marketing API
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=usX
MAILCHIMP_DEFAULT_AUDIENCE_ID=
MAILCHIMP_FROM_NAME=Fockis
MAILCHIMP_REPLY_TO=no-reply@fockis.com

# Optional overrides
MAILCHIMP_API_BASE_URL=

# Mailchimp Transactional SMS
# Requires a Standard+ account, Transactional enabled,
# an approved sending program/number, credits, and required consent.
MAILCHIMP_TRANSACTIONAL_API_KEY=
MAILCHIMP_TRANSACTIONAL_SMS_FROM=
MAILCHIMP_TRANSACTIONAL_BASE_URL=https://mandrillapp.com/api/1.1
